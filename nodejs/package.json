{
  "name": "burkut",
  "version": "1.0.0",
  "description": "Bürküt API Node.js ve TypeScript istemcisi. 15 dk gecikmeli BIST hisseleri, döviz, altın ve piyasa verileri kütüphanesi.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node build-esm.js",
    "test": "node --test test/client.test.js"
  },
  "keywords": [
    "burkut",
    "bist",
    "borsa",
    "finans",
    "hisse",
    "doviz",
    "altin",
    "tefas",
    "viop",
    "finance",
    "api",
    "sdk"
  ],
  "author": "Bürküt Finans <destek@burkutportfoy.com>",
  "license": "MIT",
  "homepage": "https://burkutportfoy.com/developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sametakan29/burkut-sdks.git",
    "directory": "nodejs"
  },
  "bugs": {
    "url": "https://github.com/sametakan29/burkut-sdks/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
